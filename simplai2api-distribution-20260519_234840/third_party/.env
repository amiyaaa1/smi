MAIL_PROVIDER=chatgptmail
# 可选值: duckmail / chatgptmail

# 代理模式:
# 1 = 普通模式：所有请求走全局 SOCKS5/WARP（邮箱不走 node-relay）
# 2 = 独立代模式：只有邮箱走 node-relay，注册/OAuth/CPA 直连
# 3 = 混合模式：邮箱走 node-relay，注册/OAuth 走全局 SOCKS5/WARP
# 4 = relay 模式：邮箱/注册/OAuth 走 node-session-proxy（同账号复用同一 session/node）
PROXY_MODE=5
MODE4_MAIL_USE_NODE_RELAY=1

# 全局 SOCKS5 / WARP 代理（模式 1 / 3 生效）
SOCKS5_PROXY=socks5://127.0.0.1:40000
# 兼容误写: sock5://127.0.0.1:40000 会自动修正为 socks5://

# 旧开关：未设置 PROXY_MODE 时，MAIL_PROXY_ENABLED=1 会回退为模式 2
MAIL_PROXY_ENABLED=1

# 邮箱独立代理（模式 2 / 3 生效）
MAIL_PROXY_API_URL=http://127.0.0.1:3017/api/node-relay
MAIL_PROXY_API_KEY=zx11606
NODE_SESSION_PROXY_API_URL=http://127.0.0.1:3017/api/node-session-proxy
NODE_SESSION_PROXY_API_KEY=zx11606
MAIL_PROXY_RANDOM_TOP_N=100
NODE_SESSION_RANDOM_TOP_N=100
MAIL_PROXY_POOL=node
MAIL_PROXY_NODE_ID=
MAIL_PROXY_ROTATE_ON_429=1
MAIL_PROXY_MAX_ROTATIONS=10
MAIL_PROXY_ROTATE_INTERVAL_SECONDS=0.5
MAIL_PROXY_SESSION_PREFIX=codex-mail
CHATGPTMAIL_REQUEST_INTERVAL=5.0
MAIL_POLL_BASE_SECONDS=1.5
MAIL_POLL_MAX_SECONDS=4.0
MAIL_POLL_EMPTY_BACKOFF_STEP_SECONDS=0.5
MAIL_POLL_JITTER_SECONDS=0.8
OTP_RESEND_AFTER_SECONDS=20
REGISTER_OTP_TIMEOUT_SECONDS=90
OAUTH_OTP_TIMEOUT_WITH_SNAPSHOT_SECONDS=45
OAUTH_OTP_TIMEOUT_NO_SNAPSHOT_SECONDS=60
AUTO_OAUTH_RETRY_ENABLED=1
AUTO_OAUTH_RETRY_WORKERS=1
AUTO_OAUTH_RETRY_DELAY_SECONDS=2
AUTO_OAUTH_RETRY_IMMEDIATE_RETRY_SECONDS=1
AUTO_OAUTH_RETRY_MAX_ATTEMPTS=1
AUTO_OAUTH_RETRY_DELETE_AFTER_FAILURES=3
AUTO_BLACKLIST_BAD_EMAIL_DOMAINS=1
BAD_EMAIL_DOMAIN_RETRY_LIMIT=2
BAD_EMAIL_GENERATE_MAX_ATTEMPTS=8

# CHATGPTMAIL_BASE_URL=https://mail.chatgpt.org.uk
# CHATGPTMAIL_LOCALE=zh

# Web 管理面板
WEB_PANEL_HOST=0.0.0.0
WEB_PANEL_PORT=8788
WEB_WORKER_CHANGE_KEY=zx11606
WEB_PANEL_BASE_PATH=/gpt-dc
WEB_CPA_DEMAND_GATE_PENDING_BUFFER=5
LOG_MAX_MB=20

# CPA 401 自动清理
CPA_MANAGEMENT_NO_PROXY=1
CPA_AUTO_DELETE_401_ENABLED=1
CPA_AUTO_DELETE_401_THRESHOLD=20
CPA_AUTO_DELETE_401_MIN_INTERVAL_SECONDS=120
CPA_AUTO_DELETE_401_WORKERS=10
CPA_AUTO_DELETE_401_MAX_DELETE_PER_RUN=0
WEB_AUTO_OAUTH_REFILL_ENABLED=1
WEB_AUTO_OAUTH_REFILL_CHECK_SECONDS=2
WEB_AUTO_START_RUN=1
WEB_AUTO_START_RUN_DELAY_SECONDS=1
